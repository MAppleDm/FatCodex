# Copy to .env and fill in. Never commit .env.

# --- postgres (used by gateway) ---
POSTGRES_USER=diet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diet

# --- gateway ---
GATEWAY_PORT=8080
# 127.0.0.1 = this computer only (the Android emulator reaches it as 10.0.2.2).
# Use 0.0.0.0 to reach it from a phone on your Wi-Fi. The app talks plain HTTP, so only do that on a network you trust.
GATEWAY_BIND=127.0.0.1
# REQUIRED: the gateway refuses to start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Login codes are printed to the gateway log unless SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- ai-parser (the only container that sees the DeepSeek key) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- stt ---
# tiny/base/small/medium. "small" is ~470 MB, downloaded on first start.
STT_MODEL=small
# ISO code (ru, en...) or empty to auto-detect.
STT_LANGUAGE=

# --- nutrition ---
# Min share of query words that must appear in a food name to count as a match.
NUTRITION_MIN_COVERAGE=0.75
# Published on 127.0.0.1 only, for debugging with curl.
NUTRITION_PORT=8084
