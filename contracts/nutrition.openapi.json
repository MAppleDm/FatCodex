{
  "components": {
    "schemas": {
      "FoodOut": {
        "properties": {
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "derived": {
            "description": "True when kcal was computed from macros (4/9/4) because the source had none",
            "title": "Derived",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "per100g": {
            "$ref": "#/components/schemas/Nutrients"
          },
          "source": {
            "description": "usda_foundation | usda_sr_legacy | usda_fndds | off",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "name",
          "per100g",
          "derived"
        ],
        "title": "FoodOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "foods": {
            "title": "Foods",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "foods"
        ],
        "title": "Health",
        "type": "object"
      },
      "ItemResult": {
        "properties": {
          "alternatives": {
            "description": "Names of the closest other candidates",
            "items": {
              "type": "string"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "food": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FoodOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "grams": {
            "title": "Grams",
            "type": "number"
          },
          "matched": {
            "description": "False means no food matched well enough; no numbers are invented",
            "title": "Matched",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nutrients": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Nutrients"
              },
              {
                "type": "null"
              }
            ],
            "description": "For `grams` of the food, rounded to 0.1"
          },
          "score": {
            "description": "0..1 ranking score of the best candidate (0 when nothing was found)",
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "name",
          "grams",
          "matched",
          "score"
        ],
        "title": "ItemResult",
        "type": "object"
      },
      "LookupItem": {
        "properties": {
          "grams": {
            "exclusiveMinimum": 0.0,
            "maximum": 5000.0,
            "title": "Grams",
            "type": "number"
          },
          "name": {
            "description": "Food as the user said it (any language)",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "English USDA-style name, e.g. 'chicken breast cooked'. Searched together with `name`.",
            "title": "Query"
          }
        },
        "required": [
          "name",
          "grams"
        ],
        "title": "LookupItem",
        "type": "object"
      },
      "LookupRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LookupItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "LookupRequest",
        "type": "object"
      },
      "LookupResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemResult"
            },
            "title": "Items",
            "type": "array"
          },
          "totals": {
            "$ref": "#/components/schemas/Nutrients",
            "description": "Sum over matched items only"
          }
        },
        "required": [
          "items",
          "totals"
        ],
        "title": "LookupResponse",
        "type": "object"
      },
      "Nutrients": {
        "properties": {
          "carbs": {
            "description": "Grams",
            "title": "Carbs",
            "type": "number"
          },
          "fat": {
            "description": "Grams",
            "title": "Fat",
            "type": "number"
          },
          "kcal": {
            "description": "Kilocalories",
            "title": "Kcal",
            "type": "number"
          },
          "protein": {
            "description": "Grams",
            "title": "Protein",
            "type": "number"
          }
        },
        "required": [
          "kcal",
          "protein",
          "fat",
          "carbs"
        ],
        "title": "Nutrients",
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "coverage": {
            "title": "Coverage",
            "type": "number"
          },
          "food": {
            "$ref": "#/components/schemas/FoodOut"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "food",
          "score",
          "coverage"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DietApp nutrition",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/foods/search": {
      "get": {
        "operationId": "search_foods_v1_foods_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Search Foods V1 Foods Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Foods",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/lookup": {
      "post": {
        "description": "Match each item to a food and compute its kcal/protein/fat/carbs for the given grams.\n\nUnmatched items come back with `matched=false` and no numbers.",
        "operationId": "lookup_items_v1_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lookup Items",
        "tags": [
          "foods"
        ]
      }
    }
  }
}
