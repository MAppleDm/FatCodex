{
  "components": {
    "schemas": {
      "ContextEntry": {
        "description": "An entry already in today's diary. Lets the model turn \"масла было меньше\" into an update.",
        "properties": {
          "grams": {
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Grams",
            "type": "number"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "grams"
        ],
        "title": "ContextEntry",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "description": "llm_timeout | llm_unavailable | llm_bad_output | llm_rejected | llm_auth",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FrequentItem": {
        "properties": {
          "grams": {
            "exclusiveMinimum": 0.0,
            "maximum": 5000.0,
            "title": "Grams",
            "type": "number"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "query_en": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query En"
          }
        },
        "required": [
          "name",
          "grams"
        ],
        "title": "FrequentItem",
        "type": "object"
      },
      "FrequentMeal": {
        "description": "A habitual meal, for \"как обычно\".",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FrequentItem"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "label",
          "items"
        ],
        "title": "FrequentMeal",
        "type": "object"
      },
      "Health": {
        "properties": {
          "cache": {
            "description": "redis | none",
            "title": "Cache",
            "type": "string"
          },
          "configured": {
            "description": "False when DEEPSEEK_API_KEY is not set",
            "title": "Configured",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model",
          "configured",
          "cache"
        ],
        "title": "Health",
        "type": "object"
      },
      "ParseContext": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ContextEntry"
            },
            "maxItems": 100,
            "title": "Entries",
            "type": "array"
          },
          "frequent": {
            "items": {
              "$ref": "#/components/schemas/FrequentMeal"
            },
            "maxItems": 10,
            "title": "Frequent",
            "type": "array"
          },
          "local_time": {
            "anyOf": [
              {
                "pattern": "^\\d{2}:\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HH:MM, user's clock",
            "title": "Local Time"
          },
          "pending_question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingQuestion"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ParseContext",
        "type": "object"
      },
      "ParseRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ParseContext"
          },
          "image_base64": {
            "anyOf": [
              {
                "maxLength": 6000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Photo bytes, base64 without a data: prefix",
            "title": "Image Base64"
          },
          "image_mime": {
            "default": "image/jpeg",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Image Mime",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "title": "ParseRequest",
        "type": "object"
      },
      "ParseResponse": {
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "clarify_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ONE short question, present iff some item has confidence below the threshold",
            "title": "Clarify Question"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ParsedItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ParseResponse",
        "type": "object"
      },
      "ParsedItem": {
        "properties": {
          "action": {
            "description": "add: new food. update/remove: change an existing entry given by target_id",
            "enum": [
              "add",
              "update",
              "remove"
            ],
            "title": "Action",
            "type": "string"
          },
          "clarify_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set on at most one item, the one the response-level question is about",
            "title": "Clarify Question"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "grams": {
            "description": "Total grams for add/update (the NEW total); 0 for remove",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Grams",
            "type": "number"
          },
          "name": {
            "description": "Short food name in the user's language",
            "title": "Name",
            "type": "string"
          },
          "query_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "English USDA-style name for nutrition lookup",
            "title": "Query En"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Entry id from context.entries (update/remove only)",
            "title": "Target Id"
          }
        },
        "required": [
          "action",
          "name",
          "grams",
          "confidence"
        ],
        "title": "ParsedItem",
        "type": "object"
      },
      "PendingQuestion": {
        "description": "The clarifying question the app asked last; the next message is most likely its answer.",
        "properties": {
          "question": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "target_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Entry the question was about",
            "title": "Target Id"
          }
        },
        "required": [
          "question"
        ],
        "title": "PendingQuestion",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DietApp ai-parser",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/parse": {
      "post": {
        "description": "Extract foods (name, grams, confidence) from text and/or a photo.\n\nReturns at most one clarifying question, and only when some item's confidence is below the\nthreshold. Calories are never produced here: pass the items to the nutrition service.\nFor `update`/`remove`, the entry must be listed in `context.entries`.",
        "operationId": "parse_v1_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "llm_rejected"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "llm_auth"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "llm_unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "llm_timeout"
          }
        },
        "summary": "Parse",
        "tags": [
          "parse"
        ]
      }
    }
  }
}
