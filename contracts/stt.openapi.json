{
  "components": {
    "schemas": {
      "Body_transcribe_v1_transcribe_post": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "description": "wav, m4a/aac, mp3, ogg/opus, flac, webm, 3gp",
            "title": "Audio",
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 639-1; omit to auto-detect",
            "title": "Language"
          }
        },
        "required": [
          "audio"
        ],
        "title": "Body_transcribe_v1_transcribe_post",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "description": "audio_too_large | audio_too_long | audio_unreadable | stt_unavailable | stt_internal",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "loaded": {
            "description": "False until the model has been loaded (first start downloads it)",
            "title": "Loaded",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model",
          "loaded"
        ],
        "title": "Health",
        "type": "object"
      },
      "TranscribeResponse": {
        "properties": {
          "duration_s": {
            "description": "Length of the audio in seconds",
            "title": "Duration S",
            "type": "number"
          },
          "language": {
            "description": "ISO 639-1 code used or detected",
            "title": "Language",
            "type": "string"
          },
          "text": {
            "description": "Recognised speech; empty when nothing intelligible was said",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "language",
          "duration_s"
        ],
        "title": "TranscribeResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DietApp stt",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/transcribe": {
      "post": {
        "description": "Transcribe one short voice note (up to STT_MAX_SECONDS).",
        "operationId": "transcribe_v1_transcribe_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transcribe_v1_transcribe_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscribeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "audio_too_large | audio_too_long"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "audio_unreadable"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "stt_internal"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "stt_unavailable"
          }
        },
        "summary": "Transcribe",
        "tags": [
          "stt"
        ]
      }
    }
  }
}
