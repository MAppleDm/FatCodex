{
  "components": {
    "schemas": {
      "Body_speech_to_text_v1_stt_post": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "description": "Voice note: wav, m4a/aac, mp3, ogg/opus, flac, webm, 3gp",
            "title": "Audio",
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 639-1; omit to auto-detect",
            "title": "Language"
          }
        },
        "required": [
          "audio"
        ],
        "title": "Body_speech_to_text_v1_stt_post",
        "type": "object"
      },
      "EntryOut": {
        "properties": {
          "carbs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carbs"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
          },
          "eaten_at": {
            "format": "date-time",
            "title": "Eaten At",
            "type": "string"
          },
          "fat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fat"
          },
          "food_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The database food this entry was matched to",
            "title": "Food Name"
          },
          "grams": {
            "title": "Grams",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kcal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the food was not found (status=unmatched)",
            "title": "Kcal"
          },
          "meal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meal Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "per100": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Per100"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lets the client rescale offline: value = per100 * grams / 100"
          },
          "position": {
            "description": "Order within one message; sort the diary by (eaten_at, position)",
            "title": "Position",
            "type": "integer"
          },
          "protein": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protein"
          },
          "source": {
            "enum": [
              "text",
              "voice",
              "photo"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "uncertain",
              "unmatched"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "day",
          "eaten_at",
          "position",
          "name",
          "grams",
          "status",
          "confidence",
          "source",
          "updated_at"
        ],
        "title": "EntryOut",
        "type": "object"
      },
      "EntryPatchIn": {
        "properties": {
          "grams": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 5000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grams"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "EntryPatchIn",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GoalIn": {
        "properties": {
          "calorie_goal": {
            "description": "kcal per day; values below the safety minimum are refused (goal_too_low)",
            "title": "Calorie Goal",
            "type": "integer"
          }
        },
        "required": [
          "calorie_goal"
        ],
        "title": "GoalIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "calorie_goal": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calorie Goal"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MessageIn": {
        "properties": {
          "client_id": {
            "description": "Generated by the app; retrying with the same id never applies a message twice",
            "format": "uuid",
            "title": "Client Id",
            "type": "string"
          },
          "day": {
            "description": "The user's local date for this entry",
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "eaten_at": {
            "description": "Local time with UTC offset, e.g. 2026-09-30T08:15:00+03:00",
            "format": "date-time",
            "title": "Eaten At",
            "type": "string"
          },
          "image_base64": {
            "anyOf": [
              {
                "maxLength": 6000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "JPEG/PNG/WebP bytes, base64",
            "title": "Image Base64"
          },
          "image_mime": {
            "default": "image/jpeg",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Image Mime",
            "type": "string"
          },
          "pending_question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingQuestionIn"
              },
              {
                "type": "null"
              }
            ],
            "description": "Send the question the app last showed; the text is then read as its answer"
          },
          "source": {
            "default": "text",
            "enum": [
              "text",
              "voice",
              "photo"
            ],
            "title": "Source",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "client_id",
          "day",
          "eaten_at"
        ],
        "title": "MessageIn",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "clarify_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "At most one short question to show in the chat",
            "title": "Clarify Question"
          },
          "clarify_target_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Entry the question is about, if any",
            "title": "Clarify Target Id"
          },
          "entries": {
            "description": "Entries created or changed by this message, in order",
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "removed_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Removed Ids",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "PendingQuestionIn": {
        "properties": {
          "question": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "target_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          }
        },
        "required": [
          "question"
        ],
        "title": "PendingQuestionIn",
        "type": "object"
      },
      "Per100": {
        "properties": {
          "carbs": {
            "title": "Carbs",
            "type": "number"
          },
          "fat": {
            "title": "Fat",
            "type": "number"
          },
          "kcal": {
            "title": "Kcal",
            "type": "number"
          },
          "protein": {
            "title": "Protein",
            "type": "number"
          }
        },
        "required": [
          "kcal",
          "protein",
          "fat",
          "carbs"
        ],
        "title": "Per100",
        "type": "object"
      },
      "RequestCodeIn": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 5,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "RequestCodeIn",
        "type": "object"
      },
      "SttOut": {
        "properties": {
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "language",
          "duration_s"
        ],
        "title": "SttOut",
        "type": "object"
      },
      "SyncOut": {
        "properties": {
          "calorie_goal": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calorie Goal"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "has_more": {
            "description": "True when a table hit the page size; call again right away with next_since",
            "title": "Has More",
            "type": "boolean"
          },
          "next_since": {
            "description": "Pass as `since` on the next call. Re-delivered rows are harmless: upsert by id.",
            "format": "date-time",
            "title": "Next Since",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "weights": {
            "items": {
              "$ref": "#/components/schemas/WeightOut"
            },
            "title": "Weights",
            "type": "array"
          }
        },
        "required": [
          "server_time",
          "next_since",
          "has_more",
          "entries",
          "weights"
        ],
        "title": "SyncOut",
        "type": "object"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds until the token expires",
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyCodeIn": {
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 5,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "title": "VerifyCodeIn",
        "type": "object"
      },
      "WeightIn": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "kg": {
            "maximum": 400.0,
            "minimum": 20.0,
            "title": "Kg",
            "type": "number"
          }
        },
        "required": [
          "day",
          "kg"
        ],
        "title": "WeightIn",
        "type": "object"
      },
      "WeightOut": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kg": {
            "title": "Kg",
            "type": "number"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "day",
          "kg",
          "updated_at"
        ],
        "title": "WeightOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token from POST /v1/auth/verify",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DietApp gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/auth/request-code": {
      "post": {
        "description": "Email a 6-digit login code. Always answers 204 for any address, so it does not reveal who has an account.",
        "operationId": "request_code_v1_auth_request_code_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCodeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Request Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/verify": {
      "post": {
        "description": "Exchange the emailed code for an access token. Creates the account on first login.",
        "operationId": "verify_v1_auth_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/entries/{entry_id}": {
      "delete": {
        "operationId": "delete_entry_v1_entries__entry_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "entry_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Entry Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Entry",
        "tags": [
          "diary"
        ]
      },
      "patch": {
        "description": "Edit a row in place. Changing only grams is pure arithmetic; changing the name looks the food up again.",
        "operationId": "patch_entry_v1_entries__entry_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "entry_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Entry Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryPatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Patch Entry",
        "tags": [
          "diary"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "diary"
        ]
      }
    },
    "/v1/me/goal": {
      "put": {
        "description": "Set the daily calorie goal. Goals under the safety minimum are refused, never adjusted silently.",
        "operationId": "set_goal_v1_me_goal_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Set Goal",
        "tags": [
          "diary"
        ]
