{
  "type": "function",
  "function": {
    "name": "record_food",
    "description": "Record the foods mentioned or shown, or corrections to existing diary entries.",
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "update",
                  "remove"
                ]
              },
              "target_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Entry id for update/remove"
              },
              "name": {
                "type": "string",
                "description": "Short name in the user's language"
              },
              "query_en": {
                "type": "string",
                "description": "USDA SR Legacy style, food first: 'rice, white, long-grain, cooked'"
              },
              "grams": {
                "type": "number",
                "description": "Total grams (new total for update, 0 for remove)"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "clarify_question": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "action",
              "name",
              "grams",
              "confidence"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
